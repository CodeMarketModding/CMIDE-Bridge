<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><LangVersion>latest</LangVersion><AssemblyName>CodeMarket.LiveIDE.HiddenFolders</AssemblyName><GenerateAssemblyInfo>false</GenerateAssemblyInfo><BepCore Condition="'$(BepCore)' == '' and '$(GameRoot)' != ''">$(GameRoot)\BepInEx\core</BepCore><GameManaged Condition="'$(GameManaged)' == '' and '$(GameRoot)' != ''">$(GameRoot)\Code Market_Data\Managed</GameManaged></PropertyGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences" Condition="!Exists('$(BepCore)\BepInEx.dll') Or !Exists('$(GameManaged)\JavaMarket.dll')">
    <Error Text="Set GameRoot to your Code Market installation with BepInEx installed, or set both BepCore and GameManaged." />
  </Target>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JavaMarket"><HintPath>$(GameManaged)\JavaMarket.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JavaMarket.Java"><HintPath>$(GameManaged)\JavaMarket.Java.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JavaMarket.CSharp"><HintPath>$(GameManaged)\JavaMarket.CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JavaMarket.Cpp"><HintPath>$(GameManaged)\JavaMarket.Cpp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(GameManaged)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
